DATABASE_URL=postgresql://kb:kb@localhost:5432/kb

# Models: fully local through Ollama (default)
LLM_PROVIDER=ollama
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_EMBED_MODEL=bge-m3
OLLAMA_CHAT_MODEL=qwen2.5:7b-instruct
OLLAMA_NUM_CTX=8192
# Reranking with a local LLM is slow; keep off until the eval shows you need it
USE_RERANK=false
USE_HYBRID=true
MIN_VECTOR_SIM=0.30

# Optional later: AWS Bedrock instead of Ollama (set LLM_PROVIDER=bedrock)
AWS_REGION=us-east-1
EMBED_MODEL_ID=amazon.titan-embed-text-v2:0
ANSWER_MODEL_ID=us.anthropic.claude-sonnet-4-5-20250929-v1:0
RERANK_MODEL_ID=us.anthropic.claude-haiku-4-5-20251001-v1:0

CONFLUENCE_BASE_URL=https://yourcompany.atlassian.net
JIRA_BASE_URL=https://yourcompany.atlassian.net
ATLASSIAN_EMAIL=you@yourcompany.com
ATLASSIAN_API_TOKEN=

MS_TENANT_ID=
MS_CLIENT_ID=
MS_CLIENT_SECRET=
MS_DRIVE_ID=

API_URL=http://localhost:8000
API_KEY=dev-key-change-me

SLACK_BOT_TOKEN=
SLACK_APP_TOKEN=

CHUNK_TARGET_CHARS=1800
CHUNK_OVERLAP_CHARS=200

# Optional: Slack/Teams incoming webhook for sync-failure alerts
ALERT_WEBHOOK_URL=
